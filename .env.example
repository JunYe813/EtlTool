# 数据库连接模板
# 使用：复制本文件为 .env，填入自己的连接信息（.env 已被 gitignore，不会提交）
#
# .env.example  --复制为-->  .env

# --- PostgreSQL ---
DB_HOST = 127.0.0.1
DB_PORT = 5432
DB_NAME = etl_data
DB_USER = postgres
DB_PASSWORD = your_password_here

# --- 原始数据目录（Olist 的 9 个 CSV 放这里）---
# Windows 用反斜杠，Linux/Mac 用正斜杠
FILE_PATH = D:/path/to/EtlData/data
